# Canonical origin src/config/seo.ts daxilində https://denizservis.az olaraq sabitdir.
# Local dev avtomatik noindex-dir. Cloudflare production branch prod-dur.
# Preview branch üçün production yazmayın; preview noindex olmalıdır.
NEXT_PUBLIC_DEPLOYMENT_ENV=
NEXT_PUBLIC_PRODUCTION_BRANCH=prod

# İstəyə bağlı GA4. ID yoxdursa analitika və consent banner-i yüklənmir.
NEXT_PUBLIC_GA_ID=

# Təsdiqlənmiş biznes məlumatları (yoxdursa əlaqə CTA-ları göstərilmir)
NEXT_PUBLIC_BUSINESS_PHONE=+994 70 552 20 21
NEXT_PUBLIC_WHATSAPP_NUMBER=+994 70 552 20 21
NEXT_PUBLIC_SERVICE_AREA=Bakı
NEXT_PUBLIC_WORKING_HOURS=

# Resend — yalnız serverdə istifadə olunur
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=

# Reverse proxy arxasında rate limit üçün istəyə görə
TRUST_PROXY=false
